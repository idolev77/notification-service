# ---------------------------------------------------------------------------
# Notification Service - Environment Template
# ---------------------------------------------------------------------------
# Copy to `.env` for local runs:   cp .env.example .env
# NEVER commit a real `.env`. All secrets/URLs MUST come from env (no hardcoding).
# ---------------------------------------------------------------------------

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=notif
POSTGRES_PASSWORD=notif
POSTGRES_DB=notifications
POSTGRES_HOST_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST_PORT=6379

# --- API -------------------------------------------------------------------
API_HOST_PORT=8000

# --- Application (consumed by pydantic-settings in Task 1.2) ---------------
# Service-internal hostnames resolve via the docker-compose network.
DATABASE_URL=postgresql+psycopg://notif:notif@db:5432/notifications
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Behavior tuning (defaults; overridable per environment) ---------------
LOG_LEVEL=INFO
# JSON-formatted logs (set false locally for human-readable logs).
LOG_JSON=true
MAX_RETRY_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=2

# --- Worker time-limits (Celery soft/hard task timeouts) -------------------
# soft -> raises SoftTimeLimitExceeded (autoretry kicks in).
# hard -> SIGKILLs the worker child; MUST exceed `soft`.
TASK_SOFT_TIME_LIMIT_SECONDS=30
TASK_HARD_TIME_LIMIT_SECONDS=60

# --- Mock provider tunables (probabilities; 0.0–1.0) -----------------------
# Set all to 0.0 in tests for deterministic runs.
EMAIL_TRANSIENT_FAILURE_RATE=0.10
EMAIL_BOUNCE_RATE=0.05
EMAIL_OPEN_RATE=0.30

# SMS — single-segment GSM-7 by default; bodies beyond this are truncated.
SMS_MAX_CHARS=160
SMS_TRANSIENT_FAILURE_RATE=0.10
SMS_FAILED_RATE=0.02

# Push.
PUSH_TRANSIENT_FAILURE_RATE=0.10
PUSH_INVALID_TOKEN_RATE=0.03
PUSH_CLICKED_RATE=0.20

# Webhook (real HTTP POST against the configured user URL).
WEBHOOK_REQUEST_TIMEOUT_SECONDS=5.0
# SSRF guard: block webhook URLs resolving to private/loopback/link-local/
# metadata IPs (e.g. http://169.254.169.254/). Disable only for dev.
WEBHOOK_BLOCK_PRIVATE_ADDRESSES=true
# Follow 3xx redirects? Disabled by default — a 30x to a private IP would
# bypass the SSRF gate that we ran on the original URL.
WEBHOOK_FOLLOW_REDIRECTS=false

# --- Frequency caps & scheduling (Sprint 4) -------------------------------
# Separate Redis logical DB so cap counters cannot collide with broker data.
RATE_LIMITER_REDIS_URL=redis://redis:6379/2
# Default false (safer): combined with the unconditional quiet-hours bypass,
# an HIGH-bypass turns any caller able to set priority=high into an
# unbounded firehose. Flip to true if you control who can mint HIGH.
FREQUENCY_CAP_HIGH_PRIORITY_BYPASS=false
# Default false (fail-CLOSED): a Redis outage drops the send rather than
# lifting caps for every user simultaneously. Flip to true on best-effort
# (e.g. marketing-only) deployments.
RATE_LIMITER_FAIL_OPEN=false
DEFAULT_FREQUENCY_CAP_PER_HOUR=0
DEFAULT_FREQUENCY_CAP_PER_DAY=0

SCHEDULED_SCAN_INTERVAL_SECONDS=30
SCHEDULED_SCAN_BATCH_SIZE=200
